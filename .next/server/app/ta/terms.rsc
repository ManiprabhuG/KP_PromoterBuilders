4:["$","html",null,{"lang":"ta","suppressHydrationWarning":true,"children":[["$","head",null,{"children":["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"RealEstateAgent\",\"name\":\"Kopuram Promoter and Builders LLP\",\"image\":\"https://kp-builders.vercel.app/images/bg-logo.png\",\"telephone\":\"+91 86818 51548\",\"email\":\"info@kopurambuilders.com\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Anna Nagar\",\"addressRegion\":\"Madurai, Tamil Nadu\",\"postalCode\":\"625020\",\"addressCountry\":\"IN\"},\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":\"4.9\",\"reviewCount\":\"55\"},\"openingHours\":\"Mo-Sa 10:00-19:00\"}"}}]}],["$","body",null,{"children":["$","$L10",null,{"attribute":"data-theme","defaultTheme":"light","enableSystem":true,"disableTransitionOnChange":true,"children":["$","$L11",null,{"lang":"ta","dict":{"brand_name":"கோபுரம்","brand_sub":"புரமோட்டர் & பில்டர்ஸ் எல்.எல்.பி","nav_home":"முகப்பு","nav_about":"எங்களைப் பற்றி","nav_projects":"திட்டங்கள்","nav_testimonials":"வாடிக்கையாளர் கருத்துக்கள்","nav_contact":"தொடர்புகொள்ள","nav_book_visit":"இலவச மனை பார்வை முன்பதிவு","top_location":"அண்ணா நகர், மதுரை, தமிழ்நாடு","top_phone":"+91 86818 51548","top_hours":"திங்கள் - சனி: காலை 10:00 - மாலை 7:00","top_ratings":"Google 4.9 ★ (55 மதிப்புரைகள்) | Justdial 4.7 ★ (42 மதிப்புரைகள்)","hero_tag":"மதுரையில் 20+ ஆண்டுகள் நம்பகமான நில அபிவிருத்தி","hero_title":"உங்கள் கனவு மனை, ","hero_title_accent":"எந்த சிரமமும் இன்றி","hero_subtitle":"DTCP & RERA அங்கீகாரம் பெற்ற சட்டப்பூர்வமான மனைப் பிரிவுகளில் 100% நம்பிக்கையுடன் முதலீடு செய்யுங்கள்.","hero_btn_visit":"இலவச மனை பார்வை முன்பதிவு","hero_btn_projects":"மனைப் பிரிவுகளைப் பார்க்க","stat_exp":"20+ ஆண்டுகள்","stat_exp_lbl":"நம்பகமான அனுபவம்","stat_layouts":"50+","stat_layouts_lbl":"நிறைவுற்ற மனைப்பிரிவுகள்","stat_rating":"4.9 ★","stat_rating_lbl":"வாடிக்கையாளர் மதிப்பீடு","stat_satisfaction":"100%","stat_satisfaction_lbl":"தெளிவான மூலப்பத்திரங்கள்","why_subtitle":"ஏன் கோபுரம் பில்டர்ஸ்?","why_title":"நம்பிக்கையும் தரமும் எங்கள் அடையாளம்","why_desc":"உங்கள் மனை வாங்கும் அனுபவத்தை முழுமையான சட்டப்பூர்வ வெளிப்படைத்தன்மையுடன் எளிதாக்குகிறோம்.","feat_1_title":"20+ ஆண்டுகள் அனுபவம்","feat_1_desc":"இரண்டு தசாப்தங்களுக்கும் மேலாக ஆயிரக்கணக்கான குடும்பங்களின் நம்பிக்கையைப் பெற்ற நிறுவனம்.","feat_2_title":"DTCP & RERA அங்கீகாரம்","feat_2_desc":"அனைத்து மனைகளும் அரசு நகரமைப்பு மற்றும் RERA விதிகளின்படி அங்கீகரிக்கப்பட்டவை.","feat_3_title":"வெளிப்படையான விலை","feat_3_desc":"மறைமுகக் கட்டணங்கள் ஏதுமில்லை. நேரடி நிறுவன விலை மற்றும் துல்லியமான விவரங்கள்.","feat_4_title":"முழுமையான வழிகாட்டுதல்","feat_4_desc":"இடத்தைப் பார்வையிடுவது முதல் பத்திரப் பதிவு வரை அனைத்து உதவிகளும் வழங்கப்படும்.","feat_5_title":"வங்கி கடன் உதவி","feat_5_desc":"முன்னணி வங்கிகள் மூலம் எளிதான மனை வாங்கும் கடன் வசதிக்கான ஏற்பாடுகள்.","feat_6_title":"பட்டா மாறுதல் உதவி","feat_6_desc":"மனை வாங்கிய பின் உடனடி பட்டா மாறுதல் மற்றும் எல்லைக் கல் நடும் சேவைகள்.","proj_subtitle":"சிறப்பு மனைப் பிரிவுகள்","proj_title":"மதுரையின் முக்கிய இடங்களில் அங்கீகரிக்கப்பட்ட மனைகள்","proj_desc":"உடனடி வீடு கட்ட ஏற்ற இடம், சிறந்த போக்குவரத்து இணைப்பு மற்றும் நவீன உள்கட்டமைப்பு வசதிகள்.","filter_all":"அனைத்து மனைகள்","filter_available":"கிடைக்கும் மனைகள்","filter_ongoing":"நடைபெறும் திட்டங்கள்","filter_soldout":"விற்பனையானவை","btn_view_details":"முழு விவரங்கள்","btn_book_visit":"மனை பார்வை முன்பதிவு","btn_download_brochure":"தகவல் கையேடு பதிவிறக்கம்","p1_title":"கோபுரம் நகர் பேஸ் 2","p1_loc":"ரிங் ரோடு / சமணர் மலை அருகில், மதுரை","p1_status":"கிடைக்கிறது","p1_desc":"இயற்கை எழில் கொஞ்சும் சூழலில், ரிங் ரோட்டிற்கு மிக அருகில் அமைந்துள்ள DTCP & RERA அங்கீகரிக்கப்பட்ட மனைப் பிரிவு.","p2_title":"கோபுரம் சங்கத்தமிழ் நகர் பேஸ் III","p2_loc":"பனைகுளம், மதுரை","p2_status":"நடைபெறுகிறது","p2_desc":"தார்ச்சாலை, தெருவிளக்குகள் மற்றும் நல்ல நிலத்தடி நீர் வசதியுடன் கூடிய விரைவாக வளர்ந்து வரும் மனைப்பிரிவு.","p3_title":"கோபுரம் டைமண்ட் சிட்டி","p3_loc":"நரசிங்கம், மாட்டுத்தாவணி அருகில், மதுரை","p3_status":"கிடைக்கிறது","p3_desc":"மாட்டுத்தாவணி பஸ் ஸ்டாண்ட் மற்றும் ஐடி பார்க் அருகில் அமைந்த சொகுசு குடியிருப்பு மனைப்பிரிவு.","test_subtitle":"வாடிக்கையாளர் நம்பிக்கை","test_title":"நமது வாடிக்கையாளர்களின் அனுபவங்கள்","test_desc":"கோபுரம் புரமோட்டர்ஸ் மூலம் நிலம் வாங்கிய குடும்பங்களின் மனமார்ந்த கருத்துக்கள்.","cta_title":"மதுரையில் உங்கள் சொந்த மனையை வாங்கத் தயாரா?","cta_desc":"இன்றே இலவச மனைப் பார்வையிட வாருங்கள். குடும்பத்துடன் வந்து பார்க்க இலவச கார் வசதி உண்டு!","cta_btn":"இப்போதே இலவச மனை பார்வை முன்பதிவு செய்ய","about_story_title":"எங்களின் 20+ ஆண்டுகால சாதனைப் பயணம்","about_story_desc":"வெளிப்படையான மற்றும் நேர்மையான மனை விற்பனையை வழங்கும் நோக்கத்துடன் தொடங்கப்பட்ட கோபுரம் புரமோட்டர் & பில்டர்ஸ் எல்.எல்.பி மதுரை ரியல் எஸ்டேட் துறையில் முன்னணி நிறுவனமாக விளங்குகிறது.","mission_title":"எங்கள் நோக்கம்","mission_desc":"அரசு அங்கீகாரம் பெற்ற மனைகளை 100% சட்டப்பூர்வ பாதுகாப்போடு வழங்கி வாடிக்கையாளர்களின் சொந்த மனை கனவை நனவாக்குவது.","vision_title":"எங்கள் தொலைநோக்கு","vision_desc":"மதுரையின் மனைப் பிரிவு அபிவிருத்தியில் தரம், நம்பிக்கை மற்றும் வாடிக்கையாளர் திருப்தியில் எப்போதும் முதன்மையாகத் திகழ்வது.","contact_title":"எங்களைத் தொடர்புகொள்ள","contact_subtitle":"அண்ணா நகர் அலுவலகத்திற்கு நேரடியாக வரலாம் அல்லது செய்தி அனுப்பலாம்.","form_name":"முழு பெயர்","form_phone":"தொலைபேசி எண்","form_email":"மின்னஞ்சல் முகவரி","form_project":"விருப்பமான மனைப் பிரிவு","form_date":"விருப்பமான தேதி","form_time":"விருப்பமான நேரம்","form_message":"உங்கள் கருத்து / கேள்வி","form_submit":"தகவல் அனுப்ப","form_book_submit":"முன்பதிவை உறுதிசெய்ய","footer_tagline":"கோபுரம் புரமோட்டர் அண்ட் பில்டர்ஸ் எல்.எல்.பி - மதுரையில் 20+ ஆண்டுகள் நம்பகமான நில அபிவிருத்தி.","footer_quick_links":"முக்கிய இணைப்புகள்","footer_contact_info":"அலுவலக தொடர்பு","footer_legal_notice":"அனைத்து மனைப் பிரிவுகளும் DTCP & RERA அங்கீகாரம் பெற்றவை.","footer_rights":"© 2026 கோபுரம் புரமோட்டர் அண்ட் பில்டர்ஸ் எல்.எல்.பி. அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.","nav_terms":"விதிமுறைகள் & நிபந்தனைகள்","nav_privacy":"தனியுரிமைக் கொள்கை","page_404_title":"404 - பக்கம் காணப்படவில்லை","page_404_desc":"நீங்கள் தேடும் பக்கம் நீக்கப்பட்டிருக்கலாம் அல்லது அதன் பெயர் மாற்றப்பட்டிருக்கலாம்.","btn_back_home":"முகப்பிற்குச் செல்ல","btn_contact_support":"அலுவலகத்தைத் தொடர்புகொள்ள"},"children":"$L12"}]}]}]]}]
